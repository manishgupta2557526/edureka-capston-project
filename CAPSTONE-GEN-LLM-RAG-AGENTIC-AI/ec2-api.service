[Unit]
Description=Enterprise Document QA FastAPI
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/enterprise-doc-agent
Environment=PATH=/home/ubuntu/enterprise-doc-agent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/home/ubuntu/enterprise-doc-agent
EnvironmentFile=/home/ubuntu/enterprise-doc-agent/.env
ExecStart=/home/ubuntu/enterprise-doc-agent/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
User=ubuntu

[Install]
WantedBy=multi-user.target
