[Unit]
Description=Enterprise Document QA Streamlit UI
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/enterprise-doc-agent
Environment=PATH=/home/ubuntu/enterprise-doc-agent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/home/ubuntu/enterprise-doc-agent
EnvironmentFile=/home/ubuntu/enterprise-doc-agent/.env
ExecStart=/home/ubuntu/enterprise-doc-agent/.venv/bin/python -m streamlit run app/streamlit_app.py --server.address 0.0.0.0 --server.port 8501
Restart=always
User=ubuntu

[Install]
WantedBy=multi-user.target
